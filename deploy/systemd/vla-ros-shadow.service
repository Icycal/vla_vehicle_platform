[Unit]
Description=VLA Vehicle ROS Shadow Runtime
After=network-online.target vla-policy-runtime.service
Wants=network-online.target
Requires=vla-policy-runtime.service

[Service]
Type=simple
User=@VLA_SERVICE_USER@
Group=@VLA_SERVICE_GROUP@
SupplementaryGroups=@VLA_ROS_GROUPS@
EnvironmentFile=-@VLA_ETC_ROOT@/vehicle.env
Environment=VLA_ENV_FILE=@VLA_ETC_ROOT@/vehicle.env
WorkingDirectory=@VLA_VAR_ROOT@
ExecStartPre=/usr/bin/test -L @VLA_OPT_ROOT@/current
ExecStart=@VLA_OPT_ROOT@/current/bin/run_ros_shadow.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
