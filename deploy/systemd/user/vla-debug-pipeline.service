[Unit]
Description=VLA Debug Pipeline
After=vla-observation-pipeline.service
Wants=vla-observation-pipeline.service
[Service]
Type=simple
WorkingDirectory=@VLA_PROJECT_ROOT@
Environment=ROS_DOMAIN_ID=43
Environment=VLA_STATE_ROOT=@VLA_STATE_ROOT@
Environment=VLA_RUNTIME_ROOT=@VLA_RUNTIME_ROOT@
Environment=VLA_LOG_ROOT=@VLA_LOG_ROOT@
ExecStart=@VLA_PROJECT_ROOT@/scripts/run_managed_component.sh vla_debug_pipeline
StandardOutput=append:@VLA_LOG_ROOT@/components/vla_debug_pipeline.log
StandardError=append:@VLA_LOG_ROOT@/components/vla_debug_pipeline.log
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=15
[Install]
WantedBy=default.target
