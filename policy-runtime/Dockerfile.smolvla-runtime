ARG BASE_IMAGE=vla-lerobot-compat:0.4.3
FROM ${BASE_IMAGE}

ARG INSTALL_TORCHAO=0
ARG TORCHAO_VERSION=

RUN if [ "${INSTALL_TORCHAO}" = "1" ]; then \
      if [ -n "${TORCHAO_VERSION}" ]; then \
        python3 -m pip install --no-cache-dir --no-deps "torchao==${TORCHAO_VERSION}"; \
      else \
        python3 -m pip install --no-cache-dir --no-deps torchao; \
      fi; \
    fi

WORKDIR /opt/vla

COPY policy-runtime/generated /opt/vla/generated
COPY policy-runtime/runtime /opt/vla/runtime

ENV PYTHONPATH=/opt/vla
ENV POLICY_PROVIDER=smolvla
ENV POLICY_OPERATION_MODE=shadow
ENV POLICY_SOCKET_PATH=/run/vla-policy/policy.sock
ENV PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV HF_DATASETS_OFFLINE=1

CMD ["python3", "-m", "runtime.server"]
