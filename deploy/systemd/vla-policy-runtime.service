[Unit]
Description=VLA Policy Runtime
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=wheeltec
Group=wheeltec
SupplementaryGroups=docker
EnvironmentFile=-/etc/vla-vehicle/vehicle.env
ExecStartPre=/usr/bin/test -L /opt/vla-vehicle/current
ExecStart=/opt/vla-vehicle/current/bin/run_policy_runtime.sh
ExecStop=/opt/vla-vehicle/current/bin/stop_policy_runtime.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
