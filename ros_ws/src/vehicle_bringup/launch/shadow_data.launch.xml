<launch>
  <arg name="shadow_params" default="$(find-pkg-share vehicle_bringup)/config/phase1_shadow.yaml"/>
  <node pkg="vehicle_data" exec="shadow_evaluator" name="shadow_evaluator" output="screen">
    <param from="$(var shadow_params)"/>
  </node>
  <node pkg="vehicle_data" exec="episode_recorder" name="episode_recorder" output="screen">
    <param from="$(var shadow_params)"/>
  </node>
</launch>