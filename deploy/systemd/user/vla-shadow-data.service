[Unit]
Description=VLA Shadow Evaluation and Episode Data
After=vla-debug-pipeline.service
Wants=vla-debug-pipeline.service
[Service]
Type=simple
WorkingDirectory=@VLA_PROJECT_ROOT@
Environment=ROS_DOMAIN_ID=43
Environment=VLA_STATE_ROOT=@VLA_STATE_ROOT@
Environment=VLA_RUNTIME_ROOT=@VLA_RUNTIME_ROOT@
Environment=VLA_LOG_ROOT=@VLA_LOG_ROOT@
ExecStart=@VLA_PROJECT_ROOT@/scripts/run_managed_component.sh shadow_data
StandardOutput=append:@VLA_LOG_ROOT@/components/shadow_data.log
StandardError=append:@VLA_LOG_ROOT@/components/shadow_data.log
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=15
[Install]
WantedBy=default.target
