<launch>
  <arg name="enable_camera" default="true"/>
  <arg name="camera_params"
       default="$(find-pkg-share vehicle_bringup)/config/front_camera.yaml"/>
  <arg name="shadow_params"
       default="$(find-pkg-share vehicle_bringup)/config/phase1_shadow.yaml"/>
  <arg name="policy_params_file"
       default="$(find-pkg-share vehicle_bringup)/config/phase0.yaml"/>

  <include file="$(find-pkg-share vehicle_bringup)/launch/phase0.launch.xml">
    <arg name="policy_params_file" value="$(var policy_params_file)"/>
  </include>

  <include if="$(var enable_camera)"
           file="$(find-pkg-share vehicle_bringup)/launch/front_camera.launch.xml">
    <arg name="camera_params" value="$(var camera_params)"/>
  </include>

  <node pkg="vehicle_data" exec="observation_monitor"
        name="observation_monitor" output="screen">
    <param from="$(var shadow_params)"/>
  </node>

  <node pkg="vehicle_adapters" exec="observation_adapter"
        name="observation_adapter" output="screen">
    <param from="$(var shadow_params)"/>
  </node>

  <node pkg="vehicle_data" exec="shadow_evaluator"
        name="shadow_evaluator" output="screen">
    <param from="$(var shadow_params)"/>
  </node>

  <node pkg="vehicle_data" exec="episode_recorder"
        name="episode_recorder" output="screen">
    <param from="$(var shadow_params)"/>
  </node>
</launch>
