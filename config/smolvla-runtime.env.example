VLA_PROJECT_ROOT=/path/to/vla_vehicle_platform
SMOLVLA_RUNTIME_IMAGE=vla-smolvla-runtime:0.1
SMOLVLA_MODEL_ID=smolvla-base-c83c3163
SMOLVLA_MODEL_ROOT=/path/to/vla_vehicle_platform/run/models/smolvla_base

SMOLVLA_SOURCE_IMAGE_KEY=observation.images.front
SMOLVLA_STATE_KEYS=observation.state.linear_velocity,observation.state.angular_velocity,observation.state.acceleration_x,observation.state.acceleration_y,observation.state.yaw_rate,observation.state.battery_voltage
SMOLVLA_REQUIRE_VALID_STATE=0
SMOLVLA_ALLOW_IMAGE_FALLBACK=1
SMOLVLA_WARMUP=1

# Safe default: model inference runs, but the adapter publishes zero Twist candidates.
SMOLVLA_ACTION_ADAPTER=zero
SMOLVLA_ACTION_HORIZON=8
SMOLVLA_CONTROL_PERIOD_MS=100
SMOLVLA_ALLOW_UNTRAINED_ADAPTER=0
SMOLVLA_LINEAR_ACTION_INDEX=0
SMOLVLA_ANGULAR_ACTION_INDEX=1
SMOLVLA_LINEAR_ACTION_SCALE=0.0
SMOLVLA_ANGULAR_ACTION_SCALE=0.0
SMOLVLA_LINEAR_LIMIT=0.2
SMOLVLA_ANGULAR_LIMIT=0.5
