[Unit]
Description=VLA Vehicle Operations Management Plane
After=network.target

[Service]
Type=simple
WorkingDirectory=@VLA_PROJECT_ROOT@
Environment=ROS_DOMAIN_ID=43
Environment=VLA_STATE_ROOT=@VLA_STATE_ROOT@
Environment=VLA_RUNTIME_ROOT=@VLA_RUNTIME_ROOT@
Environment=VLA_LOG_ROOT=@VLA_LOG_ROOT@
ExecStart=@VLA_PROJECT_ROOT@/scripts/run_vehicle_ops_console.sh
StandardOutput=append:@VLA_LOG_ROOT@/components/ops_console.log
StandardError=append:@VLA_LOG_ROOT@/components/ops_console.log
Restart=on-failure
RestartSec=2
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=default.target
