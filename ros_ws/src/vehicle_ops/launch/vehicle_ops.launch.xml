<launch>
  <arg name="bind_address" default="0.0.0.0"/>
  <arg name="port" default="8088"/>
  <arg name="operator_token" default=""/>
  <arg name="project_root" default="/home/wheeltec/vla_vehicle_platform"/>
  <arg name="jobs_root" default="/home/wheeltec/vla_vehicle_platform/run/ops/jobs"/>

  <node pkg="vehicle_operation" exec="operation_orchestrator" name="operation_orchestrator" output="screen">
    <param from="$(find-pkg-share vehicle_operation)/config/components.yaml"/>
  </node>

  <node pkg="vehicle_ops" exec="vehicle_ops_api" name="vehicle_ops_api" output="screen">
    <param from="$(find-pkg-share vehicle_ops)/config/vehicle_ops.yaml"/>
    <param name="bind_address" value="$(var bind_address)"/>
    <param name="port" value="$(var port)"/>
    <param name="operator_token" value="$(var operator_token)"/>
    <param name="project_root" value="$(var project_root)"/>
    <param name="jobs_root" value="$(var jobs_root)"/>
    <param name="web_root" value="$(find-pkg-share vehicle_ops)/web"/>
  </node>
</launch>