[Unit]
Description=VLA Vehicle ROS Shadow Runtime
After=network-online.target vla-policy-runtime.service
Wants=network-online.target
Requires=vla-policy-runtime.service

[Service]
Type=simple
User=wheeltec
Group=wheeltec
SupplementaryGroups=video dialout
EnvironmentFile=-/etc/vla-vehicle/vehicle.env
WorkingDirectory=/var/lib/vla-vehicle
ExecStartPre=/usr/bin/test -L /opt/vla-vehicle/current
ExecStart=/opt/vla-vehicle/current/bin/run_ros_shadow.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
